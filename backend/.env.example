# Copy this file to .env (same folder) and fill in the values.
# .env is gitignored, so these never get committed.

# Password for the scenario designer (/#/admin).
ADMIN_TOKEN=change-me-to-a-long-random-string

# PostgreSQL connection. On a Mac with Homebrew's Postgres, the defaults work and you can leave
# these commented out (database "behave", your Mac username, no password, localhost:5432).
# POSTGRES_DB=behave
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Only needed when hosting the site publicly:
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=a-long-random-string
# DJANGO_ALLOWED_HOSTS=yourname.example.com

# Spam protection for POST /response (defaults shown). Behind a hosting proxy, set
# TRUST_X_FORWARDED_FOR=true so the visitor's real IP address is used.
# RESPONSE_RATE_LIMIT=300
# RESPONSE_RATE_WINDOW_SECONDS=600
# TRUST_X_FORWARDED_FOR=false
